{
  "name": "agileharness-ui",
  "version": "0.4.1",
  "private": true,
  "description": "Board ag\u00eantico de User Story Mapping (Jeff Patton) com autorun. Roda em PRODU\u00c7\u00c3O como servi\u00e7o systemd de longa dura\u00e7\u00e3o (entrypoint pr\u00f3prio dist/ah-server.mjs, n\u00e3o next start) e publica uma superf\u00edcie MCP alcan\u00e7\u00e1vel pela internet cujas tools spawnam agentes com permiss\u00f5es desligadas nesta m\u00e1quina. Leia SECURITY.md antes de expor.",
  "scripts": {
    "dev": "bun run build:server && AGILEHARNESS_DEV=1 node dist/ah-server.mjs",
    "qa-dev": "bun scripts/qa-dev-server.ts",
    "gen-icons": "bun scripts/gen-icons.ts",
    "gen-splash": "bun scripts/gen-splash.ts",
    "build": "next build && bun run build:server",
    "build:server": "bun build src/server/main.ts --target=node --format=esm --external next --outfile ${AGILEHARNESS_SERVER_OUT:-dist/ah-server.mjs}",
    "start": "node dist/ah-server.mjs",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build:staged": "AGILEHARNESS_DIST_DIR=.next-staging AGILEHARNESS_SERVER_OUT=dist/ah-server.staged.mjs bun run build"
  },
  "dependencies": {
    "@blocknote/core": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "8.3.12",
    "@mantine/hooks": "8.3.12",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@next/env": "14.2.35",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.0",
    "lucide-react": "^0.460.0",
    "mcp-handler": "^1.1.0",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9",
    "react-zoom-pan-pinch": "^3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tailwind-merge": "^2.5.0",
    "unified": "11.0.5",
    "web-push": "^3.6.7",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  },
  "license": "Apache-2.0"
}
